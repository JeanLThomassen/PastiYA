{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/server/**"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/api/cron/notify", "schedule": "0 12 * * *" }]
}
